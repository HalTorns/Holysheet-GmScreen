# Copy these values into the Coolify Compose resource. HTTPS origins, no trailing slash.
VITE_SITE_URL=https://gmscreen.holysheet.fr
# Suggested backend subdomains; create their DNS records and configure Coolify routes.
VITE_CONVEX_URL=https://gmscreen-api.holysheet.fr
VITE_CONVEX_SITE_URL=https://gmscreen-http.holysheet.fr
# Generate two independent 32-byte hex values. Preserve them with their volumes.
CONVEX_INSTANCE_SECRET=
POSTGRES_PASSWORD=
# Private operations runtime only. Disable Available at Buildtime in Coolify.
# May stay empty for the first deployment; required by pnpm backend:deploy.
CONVEX_SELF_HOSTED_ADMIN_KEY=
# Private operations runtime only, never Available at Buildtime.
# Authentication secret: generate at least 32 random characters and preserve it.
BETTER_AUTH_SECRET=
# Infomaniak relay: fill with your supplied settings in Coolify.
# SMTP_SECURITY=tls for implicit TLS; starttls for mandatory STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
SMTP_EHLO_NAME=gmscreen.holysheet.fr
# The backend configuration command fixes the sender to admin@holysheet.fr.
# Optional Convex object storage, private backend runtime only.
# Leave endpoint, region, credentials and buckets empty to keep local storage.
# To use Garage, fill all nine values and set the three compatibility flags to true.
S3_ENDPOINT_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_STORAGE_EXPORTS_BUCKET=
S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=
S3_STORAGE_MODULES_BUCKET=
S3_STORAGE_FILES_BUCKET=
S3_STORAGE_SEARCH_BUCKET=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_DISABLE_CHECKSUMS=false
AWS_S3_DISABLE_SSE=false
# Optional public browser integrations, included during the frontend build.
VITE_SENTRY_DSN=
# Optional private SSR integration, supplied only at runtime.
SENTRY_DSN=
# Better Auth/email configuration belongs in Convex; see docs/deployment.md.
# Never put CONVEX_SELF_HOSTED_ADMIN_KEY or BETTER_AUTH_SECRET in VITE_* or build args.
