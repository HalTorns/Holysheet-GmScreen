# Public configuration: included in the browser bundle.
VITE_SITE_URL=http://localhost:3000
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Local administrative credentials are generated by pnpm setup. Never commit them.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Backend variables live in Convex, not in this frontend file.
# SITE_URL, PASSKEY_RP_ID, BETTER_AUTH_SECRET
# AUTH_EMAIL_PROVIDER, AUTH_EMAIL_FROM, MAILPIT_URL or RESEND_API_KEY
# ORGANIZATIONS_ENABLED=true or false (backend only; absent means personal mode)
