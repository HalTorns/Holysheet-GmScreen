# Public configuration: included in the browser bundle.
VITE_SITE_URL=http://localhost:3000
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Local administrative credentials are generated by pnpm setup. Never commit them.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Backend variables live in Convex, not in this frontend file.
# SITE_URL, PASSKEY_RP_ID, BETTER_AUTH_SECRET
# AUTH_EMAIL_PROVIDER, AUTH_EMAIL_FROM, MAILPIT_URL or RESEND_API_KEY
# ORGANIZATIONS_ENABLED=true or false (backend only; absent means personal mode)

# Optional browser integrations (public project keys/DSNs only).
VITE_SENTRY_DSN=
VITE_SPOTLIGHT_ENABLED=false

# Optional SSR integrations (private). pnpm dev/start load .env.local.
SENTRY_DSN=
SPOTLIGHT_ENABLED=false
ARCJET_ENABLED=false
ARCJET_KEY=
ARCJET_PROXY_SECRET=
AUTH_PROXY_SECRET=

# Optional backend variables, configured in Convex (not VITE_*):
# AUTH_MAGIC_LINK_ENABLED, AUTH_MFA_ENABLED, AUTH_ADMIN_ENABLED=false
# AUTH_GOOGLE_ENABLED, AUTH_GITHUB_ENABLED=false
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET
# ADMIN_USER_IDS: explicit stable Better Auth IDs, comma-separated
# AUTH_PROXY_REQUIRED=false and AUTH_PROXY_SECRET for an attested Arcjet perimeter
# Read docs/auth-modules.md and docs/observability.md before activation.

# Ports hôte locaux : configurer avant pnpm setup, puis conserver dans .env.docker.
# LOCAL_APP_PORT=3000
# LOCAL_CONVEX_PORT=3210
# LOCAL_CONVEX_SITE_PORT=3211
# LOCAL_DASHBOARD_PORT=6791
# LOCAL_MAILPIT_PORT=8025
# LOCAL_SPOTLIGHT_PORT=8969
# Le setup génère cette URL publique depuis LOCAL_SPOTLIGHT_PORT :
# VITE_SPOTLIGHT_URL=http://localhost:8969
# Backend Convex uniquement (passwordless par défaut) : AUTH_CREDENTIALS_ENABLED=false
