{
  "name": "boilerplate-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "setup": "node scripts/setup-local.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "backup:verify": "node scripts/verify-restore.mjs",
    "services:up": "node scripts/services.mjs up",
    "services:down": "node scripts/services.mjs down",
    "services:status": "node scripts/services.mjs status",
    "backend:dev": "convex dev",
    "backend:push": "convex dev --once",
    "auth:generate": "node scripts/generate-auth.mjs",
    "ts": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "test:e2e:organizations": "node scripts/test-organizations.mjs",
    "check": "pnpm ts && pnpm lint:ci && pnpm format:check && pnpm test:ci && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "1.6.22",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/rate-limiter": "0.4.2",
    "@convex-dev/react-query": "0.1.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.61",
    "better-auth": "1.6.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.46.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "auth": "1.6.22",
    "convex-test": "0.0.61",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "nitro": "3.0.260903-beta",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
